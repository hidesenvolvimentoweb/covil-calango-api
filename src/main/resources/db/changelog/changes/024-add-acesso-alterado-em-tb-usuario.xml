<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <!--
        Momento da última alteração de acesso do usuário (troca de senha ou de perfis). Sessões (JWT) emitidas antes
        dele são recusadas. Nulo: nenhuma alteração desde esta versão, todas as sessões válidas continuam valendo.
    -->
    <changeSet id="045-add-acesso-alterado-em-tb-usuario" author="covil-calango">
        <addColumn schemaName="public" tableName="tb_usuario">
            <column name="acesso_alterado_em" type="TIMESTAMP"/>
        </addColumn>
        <rollback>
            <dropColumn schemaName="public" tableName="tb_usuario" columnName="acesso_alterado_em"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
