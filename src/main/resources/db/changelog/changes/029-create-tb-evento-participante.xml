<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <!--
        Inscrição de uma comanda em um evento (pelo app). Um evento pago gera um pedido na comanda com o valor da
        inscrição: o pedido não tem produto e guarda o nome do item em DESCRICAO ("Evento - Torneio Locals").
    -->
    <changeSet id="050-add-descricao-tb-pedido" author="covil-calango">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists schemaName="public" tableName="tb_pedido" columnName="descricao"/>
            </not>
        </preConditions>
        <addColumn schemaName="public" tableName="tb_pedido">
            <column name="descricao" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
    <changeSet id="051-create-tb-evento-participante" author="covil-calango">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="public" tableName="tb_evento_participante"/>
            </not>
        </preConditions>
        <createTable schemaName="public" tableName="tb_evento_participante">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tb_evento_participante" nullable="false"/>
            </column>
            <column name="fk_evento" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_evento_participante_evento"
                             referencedTableSchemaName="public" referencedTableName="tb_evento" referencedColumnNames="id"/>
            </column>
            <column name="fk_comanda" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_evento_participante_comanda"
                             referencedTableSchemaName="public" referencedTableName="tb_comanda" referencedColumnNames="id"/>
            </column>
            <!-- Pedido com o valor da inscrição; nulo nos eventos gratuitos. -->
            <column name="fk_pedido" type="BIGINT">
                <constraints foreignKeyName="fk_evento_participante_pedido"
                             referencedTableSchemaName="public" referencedTableName="tb_pedido" referencedColumnNames="id"/>
            </column>
            <column name="dt_hora_inscricao" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- Uma comanda participa uma única vez de cada evento. -->
        <addUniqueConstraint schemaName="public" tableName="tb_evento_participante"
                             columnNames="fk_evento, fk_comanda" constraintName="uk_evento_participante_comanda"/>
        <createIndex schemaName="public" tableName="tb_evento_participante" indexName="ix_evento_participante_pedido">
            <column name="fk_pedido"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
