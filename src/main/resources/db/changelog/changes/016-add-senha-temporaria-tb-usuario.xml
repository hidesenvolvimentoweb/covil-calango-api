<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <changeSet id="032-add-senha-temporaria-tb-usuario" author="covil-calango">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists schemaName="public" tableName="tb_usuario" columnName="senha_temporaria"/>
            </not>
        </preConditions>
        <addColumn schemaName="public" tableName="tb_usuario">
            <column name="senha_temporaria" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
