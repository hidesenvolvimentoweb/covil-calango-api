<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <!-- Eventos da loja (torneios, board games...). As datas são o horário local do estabelecimento. -->
    <changeSet id="047-create-tb-evento" author="covil-calango">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="public" tableName="tb_evento"/>
            </not>
        </preConditions>
        <createTable schemaName="public" tableName="tb_evento">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tb_evento" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="tipo" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="descricao" type="VARCHAR(2000)"/>
            <column name="data_hora_inicio" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="data_hora_fim" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="valor_inscricao" type="DOUBLE PRECISION"/>
            <column name="vagas" type="INTEGER"/>
        </createTable>
        <sql>
            ALTER TABLE public.tb_evento
                ADD CONSTRAINT ck_tb_evento_periodo CHECK (data_hora_fim &gt; data_hora_inicio);
        </sql>
        <!-- O calendário busca os eventos por período. -->
        <createIndex schemaName="public" tableName="tb_evento" indexName="ix_tb_evento_periodo">
            <column name="data_hora_inicio"/>
            <column name="data_hora_fim"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
