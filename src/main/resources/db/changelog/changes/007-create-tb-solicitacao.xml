<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <changeSet id="017-create-tb-solicitacao" author="covil-calango">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="public" tableName="tb_solicitacao"/>
            </not>
        </preConditions>
        <createTable schemaName="public" tableName="tb_solicitacao">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tb_solicitacao" nullable="false"/>
            </column>
            <column name="sessionid" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(255)"/>
            <column name="nome" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="dt_hora" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="fk_comanda" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableSchemaName="public"
                baseTableName="tb_solicitacao"
                baseColumnNames="fk_comanda"
                constraintName="fk_tb_solicitacao_comanda"
                referencedTableSchemaName="public"
                referencedTableName="tb_comanda"
                referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
