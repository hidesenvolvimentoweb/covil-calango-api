<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <changeSet id="031-create-tb-recuperacao-senha" author="covil-calango">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="public" tableName="tb_recuperacao_senha"/>
            </not>
        </preConditions>
        <createTable schemaName="public" tableName="tb_recuperacao_senha">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tb_recuperacao_senha" nullable="false"/>
            </column>
            <column name="fk_usuario" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="token_hash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_tb_recuperacao_senha_token"/>
            </column>
            <column name="dt_hora_expiracao" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableSchemaName="public"
                baseTableName="tb_recuperacao_senha"
                baseColumnNames="fk_usuario"
                constraintName="fk_tb_recuperacao_senha_usuario"
                referencedTableSchemaName="public"
                referencedTableName="tb_usuario"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
