<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <changeSet id="018-create-tb-usuario-perfil" author="covil-calango">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="public" tableName="tb_usuario_perfil"/>
            </not>
        </preConditions>
        <createTable schemaName="public" tableName="tb_usuario_perfil">
            <column name="id_usuario" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_tb_usuario_perfil" nullable="false"/>
            </column>
            <column name="id_perfil" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_tb_usuario_perfil" nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableSchemaName="public"
                baseTableName="tb_usuario_perfil"
                baseColumnNames="id_usuario"
                constraintName="fk_tb_usuario_perfil_usuario"
                referencedTableSchemaName="public"
                referencedTableName="tb_usuario"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableSchemaName="public"
                baseTableName="tb_usuario_perfil"
                baseColumnNames="id_perfil"
                constraintName="fk_tb_usuario_perfil_perfil"
                referencedTableSchemaName="public"
                referencedTableName="tb_perfil"
                referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
