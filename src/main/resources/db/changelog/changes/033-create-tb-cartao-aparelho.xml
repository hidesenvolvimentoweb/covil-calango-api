<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <!--
        Cartões salvos no celular do cliente (sem login). O app guarda uma chave aleatória do aparelho; aqui fica só o
        hash dela, ligado ao cliente criado no provedor de pagamentos, onde os cartões ficam salvos. Nenhum dado do
        cartão é gravado na API.
    -->
    <changeSet id="058-create-tb-cartao-aparelho" author="covil-calango">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="public" tableName="tb_cartao_aparelho"/>
            </not>
        </preConditions>
        <createTable schemaName="public" tableName="tb_cartao_aparelho">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tb_cartao_aparelho" nullable="false"/>
            </column>
            <!-- SHA-256 (hexadecimal) da chave do aparelho. -->
            <column name="chave_hash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_cartao_aparelho_chave"/>
            </column>
            <column name="gateway" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <!-- Cliente no provedor (ex.: customer do Mercado Pago); nulo até o primeiro cartão ser salvo. -->
            <column name="cliente_gateway_id" type="VARCHAR(64)"/>
            <column name="dt_hora_criacao" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="dt_hora_ultimo_uso" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
