<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <changeSet id="002-create-tb-produto" author="covil-calango">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="public" tableName="tb_produto"/>
            </not>
        </preConditions>
        <createTable schemaName="public" tableName="tb_produto">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tb_produto" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(255)"/>
            <column name="categoria" type="VARCHAR(255)"/>
            <column name="imagem" type="VARCHAR(255)"/>
            <column name="valor" type="DOUBLE PRECISION"/>
            <column name="ingredientes" type="VARCHAR(255)"/>
            <column name="prazo" type="BIGINT"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
